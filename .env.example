# Copy to .env (gitignored) and fill in real values.

# ─────────────────────────────────────────────────────────────────────────
# Copernicus Data Space Ecosystem — Sentinel-2 imagery for Phase 0/1/3
# ─────────────────────────────────────────────────────────────────────────
# Sign up free at https://dataspace.copernicus.eu (instant account).
# These credentials feed the cdsetool / pystac-client downloader.
CDSE_USERNAME=your.email@example.com
CDSE_PASSWORD=your-password-here

# ─────────────────────────────────────────────────────────────────────────
# vast.ai — GPU rental for Phase 1/2/3/6/7/8
# ─────────────────────────────────────────────────────────────────────────
# Get API key from https://vast.ai/console/account/ after signup + deposit.
# Leave blank until PF-3 (we defer this until the GPU image + first GPU
# experiment are ready).
VAST_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Container registry — for pushing uav-lab:gpu image so vast.ai can pull
# ─────────────────────────────────────────────────────────────────────────
# Example: ghcr.io/<your-github-username>
CONTAINER_REGISTRY=
