# ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# PX4 build artifacts (when cloned as submodule or sibling)
PX4-Autopilot/build/
PX4-Autopilot/Tools/setup/__pycache__/

# Gazebo runtime logs
.gazebo/
.gz/
.ignition/

# Large datasets — staged manually, not version-controlled
datasets/raw/
datasets/staged/
datasets/*.tif
datasets/*.jp2
datasets/*.SAFE/

# Per-run workspaces (bags + metrics) — long-term storage handled separately
workspaces/*
!workspaces/.gitkeep

# Phase 3 production sweep summary artefacts: small files (<100 KB each)
# that are load-bearing for paper-v10 reproducibility. The 81 KB raw
# sweep.csv stays gitignored (regenerate via the campaign script).
!workspaces/phase3-prod/
workspaces/phase3-prod/*
!workspaces/phase3-prod/manifest.json
!workspaces/phase3-prod/analysis.json
!workspaces/phase3-prod/cep_vs_hops.png

# Secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# OMC / Claude Code tooling state
.omc/
.claude/
