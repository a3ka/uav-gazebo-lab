# ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# PX4 build artifacts (when cloned as submodule or sibling)
PX4-Autopilot/build/
PX4-Autopilot/Tools/setup/__pycache__/

# Gazebo runtime logs
.gazebo/
.gz/
.ignition/

# Large datasets — staged manually, not version-controlled
datasets/raw/
datasets/staged/
datasets/*.tif
datasets/*.jp2
datasets/*.SAFE/

# Per-run workspaces (bags + metrics) — long-term storage handled separately
workspaces/*
!workspaces/.gitkeep

# Phase 3 production sweep artefacts: all small (<100 KB each), all
# load-bearing for the paper-v10 erratum claim. Raw sweep.csv (81 KB)
# stays in git so reviewers can re-run the analyzer without
# regenerating the full sweep.
!workspaces/phase3-prod/
workspaces/phase3-prod/*
!workspaces/phase3-prod/manifest.json
!workspaces/phase3-prod/analysis.json
!workspaces/phase3-prod/cep_vs_hops.png
!workspaces/phase3-prod/sweep.csv

# Phase 4 production sweep artefacts (~117 KB total, all reproducibility-bearing)
!workspaces/phase4-prod/
workspaces/phase4-prod/*
!workspaces/phase4-prod/manifest.json
!workspaces/phase4-prod/analysis.json
!workspaces/phase4-prod/switching_distributions.png
!workspaces/phase4-prod/results.csv

