# uav-gazebo-lab — GPU image (Phase 1/2/3 vision work on vast.ai)
#
# Build:
#   docker build -f docker/Dockerfile.gpu -t uav-lab:gpu .
#
# Run (requires --gpus all on the host):
#   docker run --rm -it --gpus all \
#       --net=host \
#       -v $PWD:/workspace/uav-gazebo-lab \
#       -v $PWD/workspaces:/run-data \
#       -v $PWD/datasets:/datasets \
#       uav-lab:gpu
#
# Builds on the same toolchain as Dockerfile.cpu but layered on NVIDIA's
# CUDA 12.4 + cuDNN runtime, with PyTorch (CUDA) and SuperPoint/LightGlue
# pre-installed for PoO (Phase 1) + camera-driven TRN (Phase 3).
#
# Image size ~10 GB. Build once locally, push to registry, vast.ai pulls.

# CUDA 12.4 + Ubuntu 24.04 was the original target (to match the
# CUDA Toolkit version PyTorch 2.5.1 was built against, cu124), but
# NVIDIA does not publish 12.4 images on Ubuntu 24.04 -- only Ubuntu
# 22.04. We use 12.6.3 on Ubuntu 24.04 instead so the userspace
# matches Dockerfile.cpu (same ROS2 Jazzy apt repos, same Python
# minor). PyTorch cu124 wheels are forward-compatible with CUDA 12.6
# runtime per NVIDIA's CUDA compatibility guarantee.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=en_US.UTF-8

# ─────────────────────────────────────────────────────────────────────────
# Base utilities + locale (CUDA image is minimal)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg2 \
        lsb-release \
        locales \
        software-properties-common \
        git \
        wget \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        sudo \
        vim \
        less \
        jq \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────
# ROS2 Jazzy (apt repo)
# ─────────────────────────────────────────────────────────────────────────
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
        | tee /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-jazzy-perception \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rosdep init || true \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────
# Gazebo Harmonic + ros_gz bridge
# ─────────────────────────────────────────────────────────────────────────
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        | tee /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        gz-harmonic \
        ros-jazzy-ros-gz \
        ros-jazzy-ros-gz-bridge \
        ros-jazzy-ros-gz-sim \
    && rm -rf /var/lib/apt/lists/*

# uXRCE-DDS Agent (source build — not in Jazzy apt; PX4's official path)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libasio-dev \
        libtinyxml2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v2.4.3 \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/uxrce-agent \
    && cd /tmp/uxrce-agent && mkdir build && cd build \
    && cmake -G Ninja .. \
    && ninja -j$(nproc) && ninja install \
    && ldconfig /usr/local/lib/ \
    && rm -rf /tmp/uxrce-agent

# ─────────────────────────────────────────────────────────────────────────
# PX4 build deps (same set as Dockerfile.cpu)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        astyle \
        clang \
        clang-tidy \
        cppcheck \
        file \
        gdb \
        lcov \
        libfuse2 \
        libxml2-dev \
        libxml2-utils \
        libxslt1-dev \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-empy \
        python3-jinja2 \
        python3-numpy \
        python3-toml \
        python3-yaml \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# PX4 Python build deps (same mirror as Dockerfile.cpu).
COPY docker/requirements-px4.txt /tmp/requirements-px4.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        -r /tmp/requirements-px4.txt \
    && rm /tmp/requirements-px4.txt

# ─────────────────────────────────────────────────────────────────────────
# GTSAM 4.2 (source build — same as CPU image; Jazzy apt only has 4.0.3)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libboost-all-dev \
        libtbb-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 4.2 https://github.com/borglab/gtsam.git /tmp/gtsam \
    && cd /tmp/gtsam && mkdir build && cd build \
    && cmake -DGTSAM_BUILD_PYTHON=OFF \
             -DGTSAM_USE_SYSTEM_EIGEN=ON \
             -DGTSAM_BUILD_TESTS=OFF \
             -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
             -G Ninja .. \
    && ninja -j$(nproc) && ninja install \
    && ldconfig \
    && rm -rf /tmp/gtsam
# Python bindings via precompiled PyPI wheel (same as Dockerfile.cpu).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        "gtsam==4.2.*"

# ─────────────────────────────────────────────────────────────────────────
# Vision stack — PyTorch (CUDA 12.4) + SuperPoint/LightGlue
# Pinned to versions known to work with PoO pipeline (PF-5 spec).
# ─────────────────────────────────────────────────────────────────────────
# cu118 wheels chosen for broadest driver compatibility. They run on
# any NVIDIA driver supporting CUDA 11.8+ (which is essentially every
# datacenter / consumer GPU driver from 2023 onward). Originally pinned
# to cu124 to match the base image, but a vast.ai host with driver
# reporting only CUDA 12.0 (despite cuda_max_good>=12.6 advertisement)
# rejected the cu124 wheels at runtime. cu118 sidesteps that whole
# class of "host driver claims newer than it is" problems.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu118 \
        torch==2.5.1 torchvision==0.20.1
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        numpy \
        scipy \
        pandas \
        matplotlib \
        pyyaml \
        sentinelsat \
        rasterio \
        opencv-python-headless \
        kornia
# SuperPoint extractor lives in cvg/LightGlue (kornia 0.8.x removed
# its bundled SuperPoint). We install LightGlue from git for the
# extractor module; the matcher path is independent -- Phase 1 spec
# uses Lowe ratio (paper-faithful), not the LightGlue matcher.
# Pin to main; once Phase 1 baseline is locked we'll record the
# resolved commit hash here for reproducibility.
#
# --no-deps: don't let pip pull LightGlue's dependency closure
# (torch, kornia, opencv, numpy). All four already installed above at
# the versions we want. Without --no-deps + --ignore-installed, pip
# fetched torch 2.12+cu130 from default PyPI -- silently overwrote our
# cu118 pin and broke the image on hosts with cu118-compatible drivers.
# With --no-deps the runtime stack stays exactly as the cu118 layer
# left it.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        --no-deps \
        'git+https://github.com/cvg/LightGlue.git@main'

# ─────────────────────────────────────────────────────────────────────────
# Non-root user (matches Dockerfile.cpu so volume permissions align).
# Ubuntu 24.04 base images ship a default `ubuntu` user at UID 1000; remove
# it first so we can claim 1000 for our `lab` user.
# ─────────────────────────────────────────────────────────────────────────
ARG USERNAME=lab
ARG USER_UID=1000
ARG USER_GID=1000
RUN if getent passwd $USER_UID >/dev/null; then \
        userdel -r "$(getent passwd $USER_UID | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && if getent group $USER_GID >/dev/null; then \
        groupdel "$(getent group $USER_GID | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Trust all bind-mounted directories regardless of host UID (see Dockerfile.cpu
# for rationale).
RUN git config --system --add safe.directory '*'

# Source ROS2 for both root and lab shells so interactive use works
# regardless of which user vast.ai (root) or docker compose (lab) runs as.
RUN for HOME_DIR in /root /home/$USERNAME; do \
        echo "source /opt/ros/jazzy/setup.bash" >> "$HOME_DIR/.bashrc"; \
        echo "[ -f /workspace/ros2_ws/install/setup.bash ] && source /workspace/ros2_ws/install/setup.bash" >> "$HOME_DIR/.bashrc"; \
    done && chown $USERNAME:$USERNAME /home/$USERNAME/.bashrc

# Stay as root by default. vast.ai's SSH wrapper expects root to inject
# its sshd / authorize keys / etc. For local development via
# docker-compose we override with `user: ${HOST_UID}:${HOST_GID}` to get
# bind-mount file ownership right.
USER root
WORKDIR /workspace

# Long-running CMD so the container stays alive while vast.ai's
# orchestrator injects its SSH server via docker exec. /bin/bash alone
# exits immediately without a TTY, which produces
# "No such container" on the next vast.ai control command.
CMD ["sleep", "infinity"]
