# uav-gazebo-lab — GPU image (Phase 1/2/3 vision work on vast.ai)
#
# Build:
#   docker build -f docker/Dockerfile.gpu -t uav-lab:gpu .
#
# Run (requires --gpus all on the host):
#   docker run --rm -it --gpus all \
#       --net=host \
#       -v $PWD:/workspace/uav-gazebo-lab \
#       -v $PWD/workspaces:/run-data \
#       -v $PWD/datasets:/datasets \
#       uav-lab:gpu
#
# Builds on the same toolchain as Dockerfile.cpu but layered on NVIDIA's
# CUDA 12.4 + cuDNN runtime, with PyTorch (CUDA) and SuperPoint/LightGlue
# pre-installed for PoO (Phase 1) + camera-driven TRN (Phase 3).
#
# Image size ~10 GB. Build once locally, push to registry, vast.ai pulls.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=en_US.UTF-8

# ─────────────────────────────────────────────────────────────────────────
# Base utilities + locale (CUDA image is minimal)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg2 \
        lsb-release \
        locales \
        software-properties-common \
        git \
        wget \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        sudo \
        vim \
        less \
        jq \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────
# ROS2 Jazzy (apt repo)
# ─────────────────────────────────────────────────────────────────────────
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
        | tee /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-jazzy-perception \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rosdep init || true \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────
# Gazebo Harmonic + ros_gz bridge
# ─────────────────────────────────────────────────────────────────────────
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        | tee /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        gz-harmonic \
        ros-jazzy-ros-gz \
        ros-jazzy-ros-gz-bridge \
        ros-jazzy-ros-gz-sim \
    && rm -rf /var/lib/apt/lists/*

# uXRCE-DDS Agent (source build — not in Jazzy apt; PX4's official path)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libasio-dev \
        libtinyxml2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v2.4.3 \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/uxrce-agent \
    && cd /tmp/uxrce-agent && mkdir build && cd build \
    && cmake -G Ninja .. \
    && ninja -j$(nproc) && ninja install \
    && ldconfig /usr/local/lib/ \
    && rm -rf /tmp/uxrce-agent

# ─────────────────────────────────────────────────────────────────────────
# PX4 build deps (same set as Dockerfile.cpu)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        astyle \
        clang \
        clang-tidy \
        cppcheck \
        file \
        gdb \
        lcov \
        libfuse2 \
        libxml2-dev \
        libxml2-utils \
        libxslt1-dev \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-empy \
        python3-jinja2 \
        python3-numpy \
        python3-toml \
        python3-yaml \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# PX4 Python build deps (same mirror as Dockerfile.cpu).
COPY docker/requirements-px4.txt /tmp/requirements-px4.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        -r /tmp/requirements-px4.txt \
    && rm /tmp/requirements-px4.txt

# ─────────────────────────────────────────────────────────────────────────
# GTSAM 4.2 (source build — same as CPU image; Jazzy apt only has 4.0.3)
# ─────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libboost-all-dev \
        libtbb-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 4.2 https://github.com/borglab/gtsam.git /tmp/gtsam \
    && cd /tmp/gtsam && mkdir build && cd build \
    && cmake -DGTSAM_BUILD_PYTHON=OFF \
             -DGTSAM_USE_SYSTEM_EIGEN=ON \
             -DGTSAM_BUILD_TESTS=OFF \
             -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
             -G Ninja .. \
    && ninja -j$(nproc) && ninja install \
    && ldconfig \
    && rm -rf /tmp/gtsam
# Python bindings via precompiled PyPI wheel (same as Dockerfile.cpu).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        "gtsam==4.2.*"

# ─────────────────────────────────────────────────────────────────────────
# Vision stack — PyTorch (CUDA 12.4) + SuperPoint/LightGlue
# Pinned to versions known to work with PoO pipeline (PF-5 spec).
# ─────────────────────────────────────────────────────────────────────────
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.5.1 torchvision==0.20.1
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        numpy \
        scipy \
        pandas \
        matplotlib \
        pyyaml \
        sentinelsat \
        rasterio \
        opencv-python-headless \
        kornia \
        lightglue

# ─────────────────────────────────────────────────────────────────────────
# Non-root user (matches Dockerfile.cpu so volume permissions align).
# Ubuntu 24.04 base images ship a default `ubuntu` user at UID 1000; remove
# it first so we can claim 1000 for our `lab` user.
# ─────────────────────────────────────────────────────────────────────────
ARG USERNAME=lab
ARG USER_UID=1000
ARG USER_GID=1000
RUN if getent passwd $USER_UID >/dev/null; then \
        userdel -r "$(getent passwd $USER_UID | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && if getent group $USER_GID >/dev/null; then \
        groupdel "$(getent group $USER_GID | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Trust all bind-mounted directories regardless of host UID (see Dockerfile.cpu
# for rationale).
RUN git config --system --add safe.directory '*'

USER $USERNAME
WORKDIR /workspace/uav-gazebo-lab

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc \
    && echo "[ -f /workspace/ros2_ws/install/setup.bash ] && source /workspace/ros2_ws/install/setup.bash" >> ~/.bashrc

CMD ["/bin/bash"]
